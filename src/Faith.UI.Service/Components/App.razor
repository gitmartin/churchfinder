<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <base href="/" />
  <link rel="stylesheet" href="@(IsEmbed ? "/_content/Faith.UI/embed.css" : "/catalog.css")" />
  <script src="/_content/Faith.UI/faith-ui.js"></script>
  <script src="/_content/Faith.UI/embed.js"></script>
  <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body>
  <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
  <script src="/_framework/blazor.web.js"></script>
</body>
</html>

@code {
  [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
  private bool IsEmbed => HttpContext.Request.Path.StartsWithSegments("/embed");
}
