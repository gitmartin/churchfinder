# Matches compose.yaml. Use a private credential for a deployed database.
DATABASE_URL=postgresql+psycopg://churchfinder:churchfinder@localhost:5432/churchfinder
# A JSON array. Add the deployed React origin when available.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Browser key: restrict to your frontend domain(s) and Maps JavaScript API in Google Cloud.
GOOGLE_MAPS_API=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Exact origins permitted to embed the map. Same-origin embedding always works.
EMBED_ALLOWED_ORIGINS=["http://localhost:5242","http://127.0.0.1:5242"]

# Optional local-only alternative, requiring no database server:
# DATABASE_URL=sqlite:///./churchfinder.db
